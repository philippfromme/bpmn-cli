{
  "name": "@philippfromme/bpmn-cli",
  "version": "0.1.0",
  "description": "Fluent, type-safe BPMN model construction and safe publication for TypeScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philippfromme/bpmn-cli.git"
  },
  "bugs": {
    "url": "https://github.com/philippfromme/bpmn-cli/issues"
  },
  "homepage": "https://github.com/philippfromme/bpmn-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run check:types && tsc -p tsconfig.build.json",
    "build:test": "npm run clean && npm run check:types && tsc -p tsconfig.json",
    "check:types": "node scripts/generate-model-types.mjs --check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "generate:types": "node scripts/generate-model-types.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "npm run build:test && node --test \"dist/*.test.js\"",
    "test:coverage": "npm run build:test && node --test --experimental-test-coverage \"dist/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-moddle": "^10.0.0",
    "canonicalize": "^2.1.0",
    "zeebe-bpmn-moddle": "^1.16.0"
  }
}
